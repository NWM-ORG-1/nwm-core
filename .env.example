# ─── Database ───────────────────────────────────────────────────────────────
# Runtime connection (Railway: ${{Postgres.DATABASE_URL}} — private network)
DATABASE_URL=postgres://nwm:nwm@127.0.0.1:5432/nwm
# Build-time connection (Railway: ${{Postgres.DATABASE_PUBLIC_URL}}?sslmode=require).
# Railway builds cannot reach the private network, so `next build` prerenders over this URL.
DATABASE_PUBLIC_URL=

# ─── Newsroom access ────────────────────────────────────────────────────────
# Basic Auth users for /admin: "login:saltHex:hashHex;login2:..." — generate with `npm run hash-password`
ADMIN_USERS=
# Bearer token for /api/internal/* (scheduler, feed worker) — same value on both services
INTERNAL_API_SECRET=change-me
# Stable across deploys: `openssl rand -base64 32`
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://newweb.media
# 1 = seed sample content when the database is empty (first deploy only)
SEED_ON_EMPTY=0
# in-process scheduler for scheduled publishing: on | off
SCHEDULER=on
# draft generator implementation: mock (phase 1) | claude (phase 3)
DRAFT_GENERATOR=mock
# 1 = lock the entire site behind Basic Auth (until 인터넷신문 registration is complete)
SITE_LOCK=0
# X-Forwarded-For hops added by our own proxies (Railway edge = 1; +1 per CDN in front).
# Rate limits use the client address that many hops from the right.
TRUSTED_PROXY_HOPS=1

# ─── CDN purge (phase 2; leave empty to disable) ────────────────────────────
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# ─── 법정 표기 overrides (optional; also editable in /admin/settings) ─────────
# Read when pages are prerendered, so on Railway a change applies on the next deploy.
LEGAL_TITLE=
LEGAL_REG_NO=
LEGAL_REG_DATE=
LEGAL_PUBLISHER=
LEGAL_EDITOR=
LEGAL_ADDRESS=
LEGAL_PHONE=
LEGAL_YOUTH_OFFICER=
LEGAL_EMAIL=
LEGAL_FOUNDED_AT=

# ─── Feed worker (phase 2) ──────────────────────────────────────────────────
# A separate process: `npm run worker` locally, a second Railway service in production
# (Dockerfile.worker). It needs DATABASE_URL and INTERNAL_API_SECRET as well.
# Contact address appended to the collector's User-Agent (NWM-FeedBot/1.0 (+https://newweb.media))
FEED_CONTACT_EMAIL=
# Replaces the User-Agent — only when an agreement with a site names one
FEED_USER_AGENT=
# Sources fetched in parallel (1–16)
WORKER_CONCURRENCY=4
# 0 = do not add new catalog sources (src/ingest/catalog) when the worker starts
WORKER_SYNC_CATALOG=1
# Where the worker sends cache invalidations; empty = NEXT_PUBLIC_SITE_URL
REVALIDATE_URL=

# ─── Data source keys (each one unlocks the sources that need it) ───────────
# Set them on the worker. The newsroom's dry run runs in the web service, so for
# that it needs them too — Railway shared variables keep both in step.
# opendart.fss.or.kr — 공시 (DART)
DART_API_KEY=
# ecos.bok.or.kr — 한국은행 경제통계
ECOS_API_KEY=
# kosis.kr — 국가통계포털
KOSIS_API_KEY=
# koreaexim.go.kr — 원/달러 매매기준율
KOREAEXIM_API_KEY=
# developers.naver.com — 데이터랩 검색어 트렌드
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# X API v2 (billed per post read; each source has a monthly cap)
X_BEARER_TOKEN=
# @BotFather — reads channels where the bot has been added as an admin
TELEGRAM_BOT_TOKEN=

# ─── Sentiment ──────────────────────────────────────────────────────────────
# Classifies community/social posts; without it the lexicon scores everything
ANTHROPIC_API_KEY=
# Classification model override (default in src/sentiment/llm.ts)
SENTIMENT_MODEL=
# Monthly spend cap for classification in USD; above it the lexicon takes over
SENTIMENT_LLM_MONTHLY_USD=30
