# syntax=docker/dockerfile:1.7
# NWM feed worker (src/worker), bundled into one file. Deployed as a second Railway
# service from this repository with the service variable
# RAILWAY_DOCKERFILE_PATH=Dockerfile.worker.
# The build needs no database: the web service's build applies migrations, and the
# worker waits on start until the migrations it was built with are in place.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY drizzle/meta/_journal.json ./drizzle/meta/
COPY src ./src
RUN npm run worker:build

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
# pdftotext: the AI desk reads press releases that are published only as PDF attachments
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs worker
COPY --from=build --chown=worker:nodejs /app/dist/worker.cjs ./dist/worker.cjs
USER worker
CMD ["node", "dist/worker.cjs"]
