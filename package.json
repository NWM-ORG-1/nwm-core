{
  "name": "nwm-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "worker:build": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker.cjs --log-level=warning",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test:unit": "tsx --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:purge-samples": "tsx scripts/purge-samples.ts",
    "db:studio": "drizzle-kit studio",
    "sources:sync": "tsx --env-file-if-exists=.env.local scripts/sources-sync.ts",
    "probe:adapters": "tsx scripts/probe/adapters.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "audit:build": "node scripts/audit-build.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run audit:build && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "4.5.7",
    "geist": "^1.8.1",
    "next": "16.4.2",
    "node-html-parser": "9.0.4",
    "postgres": "^3.4.9",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
