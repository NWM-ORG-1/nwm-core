{
  "name": "nwm-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:purge-samples": "tsx scripts/purge-samples.ts",
    "db:studio": "drizzle-kit studio",
    "hash-password": "tsx scripts/hash-password.ts",
    "audit:build": "node scripts/audit-build.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run audit:build && npm run test:e2e"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
